# Database Credentials
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=replace_with_secure_db_password
POSTGRES_DB=stockpilot

# Database Connections (used by FastAPI and Alembic)
DATABASE_URL=postgresql+asyncpg://stockpilot:replace_with_secure_db_password@db:5432/stockpilot
DATABASE_URL_SYNC=postgresql://stockpilot:replace_with_secure_db_password@db:5432/stockpilot

# Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_generated_64_char_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
ENVIRONMENT=production
APP_NAME=StockPilot
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS (Allowed Origins)
CORS_ORIGINS=https://stockpilot.in,http://stockpilot.in

# File Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# Frontend API Base URL (defaults to /api/v1 for reverse-proxy setup)
VITE_API_BASE_URL=/api/v1
